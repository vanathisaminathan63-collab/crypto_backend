PORT=5000
NODE_ENV=development

# Public Binance market data does NOT require API keys.
# Leave the keys below commented out unless you enable authenticated Binance endpoints.

# Binance API keys (OPTIONAL - only for authenticated endpoints, not used by public market data)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# CoinMarketCap (OPTIONAL - only used by the legacy /api/v1/research/* endpoints)
# Get a free key from https://pro.coinmarketcap.com/account
# CMC_API_KEY=
# CMC_BASE_URL=https://pro-api.coinmarketcap.com